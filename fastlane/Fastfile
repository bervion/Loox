default_platform(:ios)

# Repo root (fastlane/ lives at the top level for this native Xcode project).
PROJECT_ROOT = File.expand_path("..", __dir__)

APP_ID = "com.bervion.vaultify"
EXT_ID = "com.bervion.vaultify.autofill"
SAFARI_ID = "com.bervion.vaultify.safari"
SCHEME = "Vaultify"
APP_TARGET = "Vaultify"
EXT_TARGET = "VaultifyAutoFill"
SAFARI_TARGET = "VaultifySafari"
TEAM_ID = "WDNL2F75V7"

# Crashlytics symbolication. A pinned derived-data root is what makes this
# workable: the `upload-symbols` binary is vendored inside the resolved SPM
# checkout, and Xcode's default per-machine hashed DerivedData path is not
# knowable from here. Deliberately the ONLY dSYM mechanism — an in-Xcode run
# script depends on the same layout and fails silently when it drifts.
DERIVED_DATA = File.join(PROJECT_ROOT, "build", "derived-data")
UPLOAD_SYMBOLS = File.join(DERIVED_DATA, "SourcePackages", "checkouts",
                           "firebase-ios-sdk", "Crashlytics", "upload-symbols")
GSP_PATH = File.join(PROJECT_ROOT, "Vaultify", "Resources", "GoogleService-Info.plist")

# App Store Connect API key from env (no Apple ID / 2FA needed on CI).
def asc_api_key
  app_store_connect_api_key(
    key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
    issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
    key_content: ENV["APP_STORE_CONNECT_API_KEY_KEY"],
  )
end

# Build the TestFlight "What to Test" hash from metadata/apple/<locale>/release_notes.txt.
def load_localized_build_info(metadata_root = File.join(PROJECT_ROOT, "metadata", "apple"))
  result = {}
  if File.directory?(metadata_root)
    Dir.children(metadata_root).sort.each do |locale|
      path = File.join(metadata_root, locale, "release_notes.txt")
      next unless File.exist?(path)

      text = File.read(path).strip
      next if text.empty?

      result[locale] = { whats_new: text }
    end
  end
  result["default"] = { whats_new: "Bug fixes and improvements." } if result.empty?
  result
end

# Force Manual signing per target → each points at its match-managed profile.
# The Xcode project ships with Automatic signing, which fails on a CI runner that
# has no Apple account / development profile.
def force_manual_signing(target, app_identifier)
  update_code_signing_settings(
    path: File.join(PROJECT_ROOT, "Vaultify.xcodeproj"),
    use_automatic_signing: false,
    team_id: TEAM_ID,
    targets: [target],
    bundle_identifier: app_identifier,
    code_sign_identity: "Apple Distribution",
    profile_name: "match AppStore #{app_identifier}",
  )
end

platform :ios do
  desc "Sync App Store signing assets via match (readonly)"
  lane :certificates do
    match(type: "appstore", readonly: true, api_key: asc_api_key,
          app_identifier: [APP_ID, EXT_ID, SAFARI_ID])
  end

  desc "Build, sign (match), and upload to TestFlight"
  lane :build_and_upload do
    # Temp keychain + partition list so codesign can use the match identity
    # headlessly (avoids errSecInternalComponent on a fresh runner).
    setup_ci if ENV["CI"]

    api_key = asc_api_key

    match(type: "appstore", readonly: true, api_key: api_key,
          app_identifier: [APP_ID, EXT_ID, SAFARI_ID])

    force_manual_signing(APP_TARGET, APP_ID)
    force_manual_signing(EXT_TARGET, EXT_ID)
    force_manual_signing(SAFARI_TARGET, SAFARI_ID)

    build_app(
      workspace: "Vaultify.xcworkspace",
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          APP_ID => "match AppStore #{APP_ID}",
          EXT_ID => "match AppStore #{EXT_ID}",
          SAFARI_ID => "match AppStore #{SAFARI_ID}",
        },
      },
      output_directory: File.join(PROJECT_ROOT, "build", "ipa"),
      output_name: "Vaultify.ipa",
      derived_data_path: DERIVED_DATA,
    )

    # Before the upload, and loudly: without these symbols every crash report
    # from this build is raw hex addresses, and the gap only becomes visible
    # months later when someone tries to read one.
    unless File.exist?(UPLOAD_SYMBOLS)
      UI.user_error!("Crashlytics upload-symbols not found at #{UPLOAD_SYMBOLS} — the Firebase package did not resolve into #{DERIVED_DATA}")
    end
    dsym_path = lane_context[SharedValues::DSYM_OUTPUT_PATH] ||
                File.join(lane_context[SharedValues::XCODEBUILD_ARCHIVE].to_s, "dSYMs")
    UI.user_error!("No dSYMs produced by the archive (looked in #{dsym_path})") unless File.exist?(dsym_path)
    upload_symbols_to_crashlytics(
      dsym_path: dsym_path,
      gsp_path: GSP_PATH,
      binary_path: UPLOAD_SYMBOLS,
    )

    upload_to_testflight(
      api_key: api_key,
      localized_build_info: load_localized_build_info,
      skip_waiting_for_build_processing: true,
    )
  end

  desc "Submit the latest TestFlight build to App Store review"
  lane :submit do
    deliver(
      api_key: asc_api_key,
      submit_for_review: true,
      automatic_release: false,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: false,
      metadata_path: File.join(PROJECT_ROOT, "metadata", "apple"),
      force: true,
    )
  end
end
