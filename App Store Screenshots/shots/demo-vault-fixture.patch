+#if DEBUG
+import Foundation
+import CryptoKit
+import SwiftData
+
+/// Throwaway: a believable demo vault for App Store screenshots. Two Spaces,
+/// verification codes on the accounts that really have them, a deliberate
+/// weak / reused pair so Watchtower reports something true, and private email
+/// addresses linked to two logins. Every value is synthetic, every domain is a
+/// reserved example domain, and user content follows `-ui-test-language`.
+extension UITestFixtures {
+    private struct ShotCopy {
+        let personal, work, user, holder, fullName: String
+        let titles: [String: String]
+        let note, workNote: String
+        let aliasLabel: String
+        let mailNote, recoveryLabel, workProfile: String
+        let mailTags: [String]
+    }
+
+    private static func shotCopy(_ language: String) -> ShotCopy {
+        switch language {
+        case "vi":
+            return ShotCopy(
+                personal: "Hằng ngày", work: "Công việc", user: "an.nguyen", holder: "NGUYEN VAN AN", fullName: "Nguyễn Văn An",
+                titles: ["mail": "Thư cá nhân", "cloud": "Lưu trữ đám mây", "bank": "Ngân hàng",
+                         "shopping": "Mua sắm", "streaming": "Xem phim", "code": "Kho mã nguồn",
+                         "design": "Công cụ thiết kế", "chat": "Chat nhóm", "card": "Thẻ ghi nợ", "workCard": "Thẻ công ty", "workNote": "Mã cửa văn phòng",
+                         "note": "Wi-Fi ở nhà"],
+                note: "Mạng: Home-5G\nMạng khách đổi mật khẩu mỗi Chủ nhật.",
+                workNote: "Cửa chính 4821\nThẻ khách nhận ở quầy lễ tân.",
+                aliasLabel: "Đăng ký bản tin",
+                mailNote: "Hộp thư cá nhân chính.\nĐã bật đăng nhập hai bước và passkey.",
+                recoveryLabel: "Email khôi phục", workProfile: "Hồ sơ công việc",
+                mailTags: ["cá nhân", "email"])
+        case "ja":
+            return ShotCopy(
+                personal: "日常", work: "仕事", user: "haruka.sato", holder: "HARUKA SATO", fullName: "佐藤 遥",
+                titles: ["mail": "メール", "cloud": "クラウドストレージ", "bank": "銀行",
+                         "shopping": "ショッピング", "streaming": "動画配信", "code": "コード管理",
+                         "design": "デザインツール", "chat": "チームチャット", "card": "デビットカード", "workCard": "法人カード", "workNote": "オフィスの入館コード",
+                         "note": "自宅のWi-Fi"],
+                note: "ネットワーク: Home-5G\nゲスト用は毎週日曜に変更",
+                workNote: "正面入口 4821\n来客用カードは受付で受け取り",
+                aliasLabel: "ニュースレター",
+                mailNote: "個人用のメイン受信箱。\n2段階認証とパスキーを設定済み。",
+                recoveryLabel: "復旧用メール", workProfile: "仕事用プロフィール",
+                mailTags: ["個人", "メール"])
+        default:
+            return ShotCopy(
+                personal: "Everyday", work: "Work", user: "alex.morgan", holder: "ALEX MORGAN", fullName: "Alex Morgan",
+                titles: ["mail": "Personal Mail", "cloud": "Cloud Drive", "bank": "Bank",
+                         "shopping": "Shopping", "streaming": "Streaming", "code": "Code Hosting",
+                         "design": "Design Tool", "chat": "Team Chat", "card": "Debit Card", "workCard": "Company Card", "workNote": "Office door code",
+                         "note": "Wi-Fi at home"],
+                note: "Network: Home-5G\nGuest network changes every Sunday.",
+                workNote: "Front door 4821\nVisitor badges at reception.",
+                aliasLabel: "Newsletters",
+                mailNote: "Main personal inbox.\nTwo-step sign-in and a passkey are set up.",
+                recoveryLabel: "Recovery email", workProfile: "Work profile",
+                mailTags: ["personal", "email"])
+        }
+    }
+
+    private static func templated(_ kind: ItemKindID, _ role: FieldRoleID, _ value: String) -> DynamicField {
+        guard let template = ItemTemplateRegistry.definition(for: kind),
+              let section = template.sections.first(where: { $0.fields.contains { $0.roleID == role } }),
+              let descriptor = section.fields.first(where: { $0.roleID == role }) else {
+            preconditionFailure("Unknown template role")
+        }
+        var field = descriptor.makeField(sectionID: section.id)
+        field.value = value
+        return field
+    }
+
+    static func installScreenshotVault(store: VaultStore, repository: VaultRepository) throws {
+        guard let key = repository.session.vaultKey else { throw AuthError.locked }
+        repository.reload()
+        if repository.items.contains(where: { $0.id == "shot-mail" }) { return }
+
+        let copy = shotCopy(AppEnvironment.languageRequestedByTest ?? "en")
+        let email = copy.user + "@example.com"
+        let now = Date.now
+        let day: TimeInterval = 86_400
+
+        for (index, space) in [("shot-space-personal", copy.personal, "dt_user", FolderColor.blue),
+                               ("shot-space-work", copy.work, "dt_briefcase", FolderColor.purple)].enumerated() {
+            let folder = Folder(id: space.0, name: space.1, iconAsset: space.2, color: space.3,
+                                sortIndex: index, createdAt: now, updatedAt: now,
+                                personaId: repository.activePersona?.id)
+            store.context.insert(FolderRecord(id: folder.id, sealed: try repository.sealFolder(folder, key: key),
+                                              iconAsset: folder.iconAsset, colorRaw: folder.color.rawValue,
+                                              sortIndex: folder.sortIndex, createdAt: folder.createdAt,
+                                              updatedAt: folder.updatedAt))
+        }
+        try store.context.save()
+        repository.reload()
+
+        // (slug, space, user, password, site, base32 TOTP secret, favourite, age in days, icon)
+        let logins: [(String, String, String, String, String, String?, Bool, Double, String)] = [
+            ("mail", "shot-space-personal", email, "7Rk-Wq2f-Tdb9-Xm4L", "mail.example.com",
+             "JBSWY3DPEHPK3PXP", true, 12, "dt_envelope"),
+            ("cloud", "shot-space-personal", email, "Zt6-Pl9v-Hs3k-Qw8N", "drive.example.com",
+             "KRSXG5CTMVRXEZLU", true, 34, "dt_cloud"),
+            ("bank", "shot-space-personal", copy.user, "Fj2-Nx7c-Ryd4-Vb6M", "bank.example.com",
+             nil, false, 58, "dt_bank"),
+            ("shopping", "shot-space-personal", email, "summer2019", "shop.example.com",
+             nil, false, 620, "dt_cart"),
+            ("streaming", "shot-space-personal", email, "summer2019", "watch.example.net",
+             nil, false, 480, "dt_film"),
+            ("code", "shot-space-work", copy.user, "Cq4-Mz8t-Kwe2-Lp5R", "code.example.org",
+             "MFRGGZDFMZTWQ2LK", true, 21, "dt_code"),
+            ("design", "shot-space-work", email, "Dv9-Hb3s-Xqn6-Ytu1", "design.example.com",
+             "GEZDGNBVGY3TQOJQGEZA", false, 40, "dt_palette"),
+            ("chat", "shot-space-work", email, "Wm5-Ldx7-Pcv2-Bzr8", "chat.example.com",
+             "NB2W45DFOIZDUMJA", false, 15, "dt_comments"),
+        ]
+
+        try AnalyticsEngine.shared.runSuppressed {
+            // The profile card the Home header and Private Email read from.
+            var profile = VaultItem(id: "shot-profile", category: .identity, title: copy.fullName,
+                                    folderId: "shot-space-personal",
+                                    fields: [templated(.personalIdentity, .fullName, copy.fullName),
+                                             templated(.personalIdentity, .identityEmail, email)],
+                                    isDefaultIdentity: true, createdAt: now - 20 * day, updatedAt: now - 20 * day)
+            profile.semantics = ItemTemplateRegistry.definition(for: .personalIdentity)?.newItemSemantics
+            try repository.add(profile)
+
+            for (offset, login) in logins.enumerated() {
+                var fields = [templated(.login, .username, login.2),
+                              templated(.login, .password, login.3),
+                              templated(.login, .website, "https://" + login.4)]
+                if let secret = login.5 { fields.append(templated(.login, .totp, secret)) }
+                if login.0 == "mail" {
+                    // A fuller detail screen: second website, recovery email, notes, tags.
+                    fields.insert(templated(.login, .website, "https://webmail.example.com"), at: 3)
+                    fields.append(DynamicField(id: "shot-mail-recovery", label: copy.recoveryLabel,
+                                               kind: .email, value: copy.user + "@example.net"))
+                    fields.append(DynamicField(id: "shot-mail-notes", label: "Notes", kind: .multiline,
+                                               value: copy.mailNote))
+                }
+                let created = now - login.7 * day
+                var item = VaultItem(id: "shot-" + login.0, category: .login, title: copy.titles[login.0] ?? login.0,
+                                     folderId: login.1, fields: fields, favorite: login.6, iconAsset: login.8,
+                                     lastUsedAt: now - Double(offset) * 3_600, useCount: 40 - offset * 3,
+                                     rotateDays: login.0 == "bank" ? 90 : 0, passwordChangedAt: created,
+                                     createdAt: created, updatedAt: created)
+                item.semantics = ItemTemplateRegistry.definition(for: .login)?.newItemSemantics
+                if login.0 == "mail" { item.tags = copy.mailTags }
+                try repository.add(item)
+            }
+
+            // A second profile card so every type tile counts in plural.
+            var workProfile = VaultItem(id: "shot-work-profile", category: .identity, title: copy.workProfile,
+                                        folderId: "shot-space-work",
+                                        fields: [templated(.personalIdentity, .fullName, copy.fullName),
+                                                 templated(.personalIdentity, .identityEmail,
+                                                           copy.user + "@work.example.com")],
+                                        createdAt: now - 30 * day, updatedAt: now - 30 * day)
+            workProfile.semantics = ItemTemplateRegistry.definition(for: .personalIdentity)?.newItemSemantics
+            try repository.add(workProfile)
+
+            var card = VaultItem(id: "shot-card", category: .card, title: copy.titles["card"] ?? "Card",
+                                 folderId: "shot-space-personal",
+                                 fields: [templated(.paymentCard, .cardHolder, copy.holder),
+                                          templated(.paymentCard, .cardNumber, "7012 3456 7890 1232"),
+                                          templated(.paymentCard, .cardExpiry, "09/29"),
+                                          templated(.paymentCard, .cardSecurityCode, "123")],
+                                 iconAsset: "dt_credit_card", createdAt: now - 90 * day, updatedAt: now - 90 * day)
+            card.semantics = ItemTemplateRegistry.definition(for: .paymentCard)?.newItemSemantics
+            try repository.add(card)
+
+            var note = VaultItem(id: "shot-note", category: .note, title: copy.titles["note"] ?? "Note",
+                                 folderId: "shot-space-personal",
+                                 fields: [templated(.secureNote, .noteBody, copy.note)],
+                                 iconAsset: "dt_wifi", createdAt: now - 150 * day, updatedAt: now - 150 * day)
+            note.semantics = ItemTemplateRegistry.definition(for: .secureNote)?.newItemSemantics
+            try repository.add(note)
+
+            var workCard = VaultItem(id: "shot-work-card", category: .card, title: copy.titles["workCard"] ?? "Card",
+                                     folderId: "shot-space-work",
+                                     fields: [templated(.paymentCard, .cardHolder, copy.holder),
+                                              templated(.paymentCard, .cardNumber, "7012 9876 5432 1040"),
+                                              templated(.paymentCard, .cardExpiry, "03/28"),
+                                              templated(.paymentCard, .cardSecurityCode, "456")],
+                                     iconAsset: "dt_credit_card", createdAt: now - 70 * day, updatedAt: now - 70 * day)
+            workCard.semantics = ItemTemplateRegistry.definition(for: .paymentCard)?.newItemSemantics
+            try repository.add(workCard)
+
+            var workNote = VaultItem(id: "shot-work-note", category: .note, title: copy.titles["workNote"] ?? "Note",
+                                     folderId: "shot-space-work",
+                                     fields: [templated(.secureNote, .noteBody, copy.workNote)],
+                                     createdAt: now - 45 * day, updatedAt: now - 45 * day)
+            workNote.semantics = ItemTemplateRegistry.definition(for: .secureNote)?.newItemSemantics
+            try repository.add(workNote)
+        }
+        // Synthetic passkeys (fresh P-256 keys, never registered anywhere) so
+        // the login detail shows its passkey row and the hub counts read plural.
+        let passkeys = PasskeyVault(store: store)
+        for (index, rp) in ["mail.example.com", "code.example.org"].enumerated() {
+            let secret = PasskeySecret(relyingParty: rp, userName: index == 0 ? email : copy.user,
+                                       userHandle: Data((0..<16).map { _ in UInt8.random(in: 0...255) }),
+                                       credentialID: Data((0..<16).map { _ in UInt8.random(in: 0...255) }),
+                                       privateKeyRaw: P256.Signing.PrivateKey().rawRepresentation,
+                                       counter: 0, createdAt: now - Double(20 + index * 15) * day, flags: 0x1D)
+            _ = try passkeys.save(secret, key: key)
+        }
+        repository.reload()
+        try installScreenshotPrivateEmail(store: store, repository: repository, inboxEmail: email,
+                                          personaLabel: copy.aliasLabel)
+    }
+
+    /// Issued addresses and a verified destination are local records only:
+    /// no relay or mail call is made.
+    private static func installScreenshotPrivateEmail(store: VaultStore, repository: VaultRepository,
+                                                      inboxEmail: String, personaLabel: String) throws {
+        guard let key = repository.session.vaultKey, let persona = repository.activePersona else { throw AuthError.locked }
+        let created = Date.now - 30 * 86_400
+        let inbox = ForwardingInbox(id: "shot-inbox", email: inboxEmail, label: nil, isDefault: true,
+                                    relayDestinationID: "synthetic-destination", verificationStatus: .verified,
+                                    createdAt: created, updatedAt: created)
+        store.context.insert(ForwardingInboxRecord(id: inbox.id, sealed: try repository.sealInbox(inbox, key: key),
+                                                   sortIndex: 0, createdAt: created, updatedAt: created))
+        // (id, tier, local part, label, linked login)
+        let aliases: [(String, AliasTier, String, String?, String?)] = [
+            ("shot-alias-shop", .perSite, "k7m2x9qf", nil, "shot-shopping"),
+            ("shot-alias-watch", .perSite, "p4tz8wna", nil, "shot-streaming"),
+            ("shot-alias-news", .persona, "river.lantern.42", personaLabel, nil),
+        ]
+        for (index, entry) in aliases.enumerated() {
+            let alias = EmailAlias(id: entry.0, personaId: persona.id, tier: entry.1, localPart: entry.2,
+                                   label: entry.3, status: .active, forwardingInboxID: inbox.id,
+                                   forwardingTarget: inboxEmail, backendMinted: true, sortIndex: index,
+                                   createdAt: created, updatedAt: created)
+            store.context.insert(EmailAliasRecord(id: alias.id, sealed: try repository.sealAlias(alias, key: key),
+                                                  sortIndex: alias.sortIndex, createdAt: created, updatedAt: created))
+        }
+        try store.context.save()
+        repository.reload()
+        for entry in aliases {
+            if let itemID = entry.4 { try repository.linkAliasToLogin(aliasID: entry.0, itemID: itemID) }
+        }
+        repository.reload()
+    }
+}
+#endif
