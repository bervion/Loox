index 0000000..e4f7acd
--- /dev/null
+++ b/VaultifyUITests/StoreScreenshotsUITests.swift
@@ -0,0 +1,182 @@
+import XCTest
+
+/// Throwaway: walks the `screenshots` fixture to each App Store screen and
+/// pauses there while a host script takes a full-resolution
+/// `xcrun simctl io screenshot`. Handshake: this test writes
+/// `<SHOT_SIGNAL_DIR>/<lang>__<slug>.ready` and waits for `.done`.
+/// Inputs (passed as TEST_RUNNER_<name>): SHOT_LANG (en|vi|ja), SHOT_SIGNAL_DIR.
+final class StoreScreenshotsUITests: XCTestCase {
+    private let app = XCUIApplication()
+    private let env = ProcessInfo.processInfo.environment
+    private var lang: String { env["SHOT_LANG"] ?? "en" }
+    private var isPad: Bool { UIDevice.current.userInterfaceIdiom == .pad }
+
+    /// Catalog values (Localizable.xcstrings) and fixture names per language.
+    private var text: [String: String] {
+        switch lang {
+        case "vi": return ["privateEmail": "Email riêng tư", "viewAll": "Xem tất cả", "space": "Hằng ngày",
+                           "name": "Nguyễn Văn An"]
+        case "ja": return ["privateEmail": "プライベートメール", "viewAll": "すべて表示", "space": "日常",
+                           "name": "佐藤 遥"]
+        default: return ["privateEmail": "Private Email", "viewAll": "View All", "space": "Everyday",
+                         "name": "Alex Morgan"]
+        }
+    }
+
+    override func setUpWithError() throws {
+        continueAfterFailure = false
+        let locale = ["en": "en_US", "vi": "vi_VN", "ja": "ja_JP"][lang] ?? "en_US"
+        app.launchArguments = ["-ui-testing", "-ui-test-fixture", "screenshots", "-ui-test-language", lang,
+                               "-AppleLanguages", "(\(lang))", "-AppleLocale", locale]
+        app.launch()
+        XCTAssertTrue(element(isPad ? "sidebar.profile" : "home.profile").waitForExistence(timeout: 30))
+        sleep(2)
+    }
+
+    func test01Home() {
+        waitForFreshCodes()
+        shot("home")
+    }
+
+    func test02Detail() {
+        openItem("shot-mail")
+        waitForFreshCodes()
+        shot("detail")
+    }
+
+    func test03ShareFields() {
+        openItem("shot-cloud")
+        tapID("item.detail.share")
+        // First chooser row is Quick Link.
+        let quickLink = app.collectionViews.buttons.firstMatch
+        XCTAssertTrue(quickLink.waitForExistence(timeout: 8))
+        quickLink.tap()
+        let website = app.switches.element(boundBy: 2)
+        XCTAssertTrue(website.waitForExistence(timeout: 8))
+        website.coordinate(withNormalizedOffset: CGVector(dx: 0.92, dy: 0.5)).tap()
+        shot("share-fields")
+    }
+
+    func test04PrivateEmail() {
+        openMembership()
+        let tile = app.staticTexts[text["privateEmail"]!].firstMatch
+        scrollUntilHittable(tile)
+        tile.tap()
+        sleep(1)
+        shot("private-email")
+    }
+
+    func test05Watchtower() {
+        selectSection(2, pad: "sidebar.tab.watchtower")
+        dismissSystemAlert()
+        sleep(2)
+        dismissSystemAlert()
+        shot("watchtower", settle: 3)
+    }
+
+    func test06Membership() {
+        openMembership()
+        shot("membership")
+    }
+
+    func test07Vault() {
+        if isPad {
+            tapID("sidebar.space.shot-space-personal")
+        } else {
+            selectSection(1, pad: "")
+            let space = app.staticTexts[text["space"]!].firstMatch
+            XCTAssertTrue(space.waitForExistence(timeout: 8))
+            space.tap()
+        }
+        shot("vault")
+    }
+
+    func test08Codes() {
+        let viewAll = app.buttons[text["viewAll"]!].firstMatch
+        XCTAssertTrue(viewAll.waitForExistence(timeout: 8))
+        viewAll.tap()
+        waitForFreshCodes()
+        shot("codes")
+    }
+
+    // MARK: - Navigation
+
+    private func openItem(_ id: String) {
+        let row = app.descendants(matching: .any)
+            .matching(NSPredicate(format: "identifier BEGINSWITH %@", "vault.item.\(id).")).firstMatch
+        XCTAssertTrue(row.waitForExistence(timeout: 8), "Missing row \(id)")
+        scrollUntilHittable(row)
+        row.tap()
+        XCTAssertTrue(element("item.detail.share").waitForExistence(timeout: 8))
+        sleep(1)
+    }
+
+    private func openMembership() {
+        tapID(isPad ? "sidebar.profile" : "home.profile")
+        let hubRow = app.staticTexts["Loox+"].firstMatch
+        XCTAssertTrue(hubRow.waitForExistence(timeout: 8))
+        hubRow.tap()
+        sleep(2)
+    }
+
+    /// iPhone: the tab bar item at `index`. iPad: the sidebar row `pad`.
+    private func selectSection(_ index: Int, pad: String) {
+        if isPad { tapID(pad); return }
+        let tab = app.tabBars.buttons.element(boundBy: index)
+        XCTAssertTrue(tab.waitForExistence(timeout: 8))
+        tab.tap()
+        sleep(1)
+    }
+
+    private func dismissSystemAlert() {
+        let springboard = XCUIApplication(bundleIdentifier: "com.apple.springboard")
+        let alert = springboard.alerts.firstMatch
+        if alert.waitForExistence(timeout: 3) {
+            alert.buttons.element(boundBy: 0).tap()
+            sleep(1)
+        }
+    }
+
+    // MARK: - Helpers
+
+    private func element(_ identifier: String) -> XCUIElement {
+        app.descendants(matching: .any).matching(identifier: identifier).firstMatch
+    }
+
+    private func tapID(_ identifier: String, timeout: TimeInterval = 8) {
+        let target = element(identifier)
+        XCTAssertTrue(target.waitForExistence(timeout: timeout), "Missing \(identifier)")
+        // Sidebar row icons carry the identifier but report "not hittable"
+        // inside their List cell; a coordinate tap lands on the row itself.
+        target.coordinate(withNormalizedOffset: CGVector(dx: 0.5, dy: 0.5)).tap()
+        sleep(1)
+    }
+
+    private func scrollUntilHittable(_ target: XCUIElement) {
+        for _ in 0..<8 where !(target.exists && target.isHittable) {
+            app.swipeUp(velocity: .slow)
+        }
+        XCTAssertTrue(target.isHittable, "Could not reach \(target)")
+    }
+
+    /// One-time codes turn amber/red near the end of their 30 s window; shoot
+    /// in the first half so every code ring reads calm.
+    private func waitForFreshCodes() {
+        while Int(Date().timeIntervalSince1970) % 30 > 12 { Thread.sleep(forTimeInterval: 0.5) }
+    }
+
+    /// Hands the current frame to the host and waits until it was captured.
+    private func shot(_ slug: String, settle: UInt32 = 2) {
+        sleep(settle)
+        guard let dir = env["SHOT_SIGNAL_DIR"] else { return }
+        let base = URL(fileURLWithPath: dir).appendingPathComponent("\(lang)__\(slug)")
+        let done = base.appendingPathExtension("done")
+        try? FileManager.default.removeItem(at: done)
+        FileManager.default.createFile(atPath: base.appendingPathExtension("ready").path, contents: Data())
+        let deadline = Date().addingTimeInterval(60)
+        while !FileManager.default.fileExists(atPath: done.path), Date() < deadline {
+            Thread.sleep(forTimeInterval: 0.3)
+        }
+        XCTAssertTrue(FileManager.default.fileExists(atPath: done.path), "Host never captured \(slug)")
+    }
+}
