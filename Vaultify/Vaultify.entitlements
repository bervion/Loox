<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.authentication-services.autofill-credential-provider</key>
	<true/>
	<!-- iCloud (CloudKit) sync — container provisioned in the developer portal.
	     Code paths stay behind the VAULTIFY_ICLOUD compile flag. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.bervion.vaultify</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<!-- Silent CloudKit pushes (near-real-time sync). Value comes from APS_ENVIRONMENT
	     (Debug → development / Release → production); manual signing embeds it verbatim,
	     so a hardcoded "development" would break production pushes on TestFlight. -->
	<key>aps-environment</key>
	<string>$(APS_ENVIRONMENT)</string>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.bervion.vaultify</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.bervion.vaultify.shared</string>
	</array>
</dict>
</plist>
