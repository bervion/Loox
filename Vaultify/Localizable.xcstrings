  "strings" : {
    "" : {},
    "#%@" : {
      "comment" : "A screen showing a list of items tagged with a specific hashtag. The argument is the hashtag.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "#%@"
          }
        }
      }
    },
    "%@ a month" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ mỗi tháng"
          }
        }
      }
    },
    "%@ a year" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ mỗi năm"
          }
        }
      }
    },
    "%@ accepted. Tap to finish setting up the share." : {
      "comment" : "Local notification body when a recipient finished accepting a share; %@ is the recipient email (device-local).",
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ đã chấp nhận. Nhấn để hoàn tất thiết lập chia sẻ."
          }
        }
      }
    },
    "%@ accepted. Waiting for their device to finish setting up, usually right after they unlock Loox." : {
      "comment" : "Resume share sheet: recipient accepted, waiting for profile.",
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ đã chấp nhận. Đang chờ thiết bị của họ hoàn tất thiết lập, thường ngay sau khi họ mở khóa Loox."
          }
        }
      }
    },
    "%@ has joined. Activate to give them access. To be sure it's really them, you can compare this safety code with the one shown at the bottom of the shared item on their device." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ đã tham gia. Kích hoạt để cấp quyền truy cập cho họ. Để chắc chắn đúng người, bạn có thể đối chiếu mã an toàn này với mã hiển thị ở cuối mục được chia sẻ trên máy của họ."
          }
        }
      }
    },
    "%@ is asking for the current verification code for %@." : {
      "comment" : "A callout that explains the request for a verification code. The first argument is the name of the person who requested the code. The second argument is the name of the item being requested.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is asking for the current verification code for %2$@."
