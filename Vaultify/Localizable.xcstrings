    "First %lld days free, then %@ each year. Auto-renews until canceled. Cancel anytime in Settings.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初の %lld 日間は無料、その後は年額 %@ です。解約するまで自動更新されます。設定からいつでも解約できます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Miễn phí %lld ngày đầu, sau đó %@ mỗi năm. Tự động gia hạn cho đến khi hủy. Bạn có thể hủy bất cứ lúc nào trong Cài đặt."
          }
        }
      }
