          }
        }
      }
    },
    "The owner's answer couldn't be verified." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The owner's answer couldn't be verified."
          }
        },
        "ja" : {
