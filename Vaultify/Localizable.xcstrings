        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ đang yêu cầu mã xác thực hiện tại cho %2$@."
          }
        }
      }
    },
    "%@ is asking to sign in with the shared passkey for %@." : {
