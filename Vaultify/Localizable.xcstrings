    "Vaultify collects no analytics and has no accounts. The only network request is the optional, anonymised breach check." : {
      "comment" : "A description of the privacy policy of Vaultify.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaultify kh\u00f4ng thu th\u1eadp ph\u00e2n t\u00edch v\u00e0 kh\u00f4ng c\u00f3 t\u00e0i kho\u1ea3n. Y\u00eau c\u1ea7u m\u1ea1ng duy nh\u1ea5t l\u00e0 vi\u1ec7c ki\u1ec3m tra r\u00f2 r\u1ec9 \u1ea9n danh, t\u00f9y ch\u1ecdn."
          }
        }
      }
