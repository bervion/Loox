          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi có người chia sẻ quyền truy cập với bạn, nó sẽ hiện ở đây."
          }
        }
      }
    },
    "Words" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Số từ"
