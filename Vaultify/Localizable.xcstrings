        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Họ có thể dùng mọi mục đăng nhập đã chia sẻ trong Nhóm này. Bạn có thể quản lý hoặc thu hồi quyền truy cập bất cứ lúc nào trong mục Gia đình."
          }
        }
