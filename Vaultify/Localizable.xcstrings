        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作るアカウントはありません。保管庫を抱えるサーバーもありません。データを人質に取るサブスクもありません。あるのはあなたの iPhone、あなたの鍵、あなたの秘密だけです。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không cần tạo tài khoản. Không máy chủ nào giữ kho của bạn. Không gói thuê bao nào giữ dữ liệu của bạn làm con tin. Chỉ có iPhone của bạn, chìa khóa của bạn, bí mật của bạn."
          }
        }
      }
    },
