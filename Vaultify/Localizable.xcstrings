    "Everything is encrypted on this device before it's stored." : {
      "comment" : "Home screen privacy reassurance",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてこの端末で暗号化してから保存されます。"
