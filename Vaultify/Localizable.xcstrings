      }
    },
    "This login is behind Extra Protection. Open Loox to reveal it." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このログインは第 2 パスワードで保護されています。表示するには Loox を開いてください。"
