    "Share Links and Send to Browser count the last 30 days.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有リンクとブラウザ送信は直近 30 日間で数えます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liên kết chia sẻ và Gửi sang trình duyệt tính theo 30 ngày gần nhất."
          }
        }
      }
    },
    "Share Links are no longer offered. Your saved vault items are unchanged.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有リンクの提供は終了しました。保存済みのアイテムに変更はありません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Loox không còn cung cấp Liên kết chia sẻ. Các mục đã lưu của bạn không thay đổi."
          }
        }
      }
    },
    "Share Links are temporarily unavailable. Your vault is not affected.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有リンクは一時的に利用できません。保管庫に影響はありません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liên kết chia sẻ tạm thời không khả dụng. Kho của bạn không bị ảnh hưởng."
          }
        }
      }
    },
    "Share Links are turned off in Settings.": {
