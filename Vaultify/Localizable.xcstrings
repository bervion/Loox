    "Share an item, or share a whole Space above, and they'll appear here." : {
      "extractionState" : "stale",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アイテムを共有するか、上からスペースごと共有すると、ここに表示されます。"
