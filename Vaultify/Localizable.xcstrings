    "Nothing is sent to a server. Your vault never leaves the device unencrypted." : {
      "comment" : "A description of the privacy policy of Vaultify.",
      "extractionState" : "stale",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーには何も送信されません。保管庫が暗号化されないままデバイスを離れることはありません。"
