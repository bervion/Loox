          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không cần tạo tài khoản. Không máy chủ nào đọc được kho của bạn. Không gói đăng ký nào giữ dữ liệu của bạn làm con tin. Chỉ có iPhone của bạn, chìa khóa của bạn, bí mật của bạn."
          }
        }
      }
    },
