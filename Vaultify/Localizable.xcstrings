    "Expires in %lld seconds": {
      "comment": "Quick View session countdown — %lld is the remaining whole seconds. The countdown passes through 1, so English needs both plural forms; Vietnamese has no grammatical plural.",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Expires in %lld second"
