    "Some attachments could not be read on this device. The backup will restore everything else." : {
      "comment" : "ExportView — message body of the incomplete-attachments dialog. Count-neutral on purpose so no plural rule is needed.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この端末で読み取れない添付ファイルがあります。バックアップはそれ以外のすべてを復元します。"
          }
        },
        "vi" : {
