    "AutoFill matches logins to apps and sites by the website address, and the username tells similar accounts apart. Add the missing details so this login fills reliably." : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動入力はウェブサイトのアドレスでログインを照合し、ユーザー名は似たアカウントを見分ける手がかりになります。不足している情報を追加すると、このログインは確実に入力されます。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tự động điền ghép mục đăng nhập với ứng dụng và trang web dựa trên địa chỉ trang web, còn tên đăng nhập giúp phân biệt các tài khoản giống nhau. Bổ sung thông tin còn thiếu để mục đăng nhập này được điền chính xác."
          }
        }
      }
    },
    "AutoFill Passwords and Passcodes" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワードとパスコードを自動入力"
