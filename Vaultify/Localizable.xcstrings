        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn sẽ đối chiếu một mã ngắn trước khi bất kỳ thứ gì được bàn giao."
          }
        }
      }
    },
    "You'll lose access to it. The owner can share with you again later.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll lose access to it. The owner can share with you again later."
