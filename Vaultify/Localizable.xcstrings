          }
        }
      }
    },
    "The backup is sealed with Argon2id + AES-256-GCM. You’ll need this password to restore it.": {
      "comment": "The text that appears under the password fields in the export view.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップは Argon2id と AES-256-GCM で封じられます。復元にはこのパスワードが必要です。"
          }
        },
        "vi": {
