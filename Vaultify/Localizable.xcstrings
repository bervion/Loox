          }
        }
      }
    },
    "This is the only setting that decides whether your Emergency Kit can rebuild your vault somewhere else." : {
      "comment" : "EmergencyKitView — subheading under the consent question.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
