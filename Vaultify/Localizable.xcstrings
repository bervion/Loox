          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "chủ sở hữu"
          }
        }
      }
    },
    "this Space": {
      "comment": "Name of the Space being shared.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスペース"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhóm này"
          }
        }
      }
    },
    "this item": {
      "comment": "Fallback item-title label when the item has no title.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアイテム"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "mục này"
          }
        }
      }
    },
    "unique passwords": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "重複のないパスワード"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "mật khẩu không trùng lặp"
          }
        }
      }
    },
    "verification code": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認コード"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "mã xác minh"
          }
        }
      }
    },
    "via iCloud": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 経由"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "qua iCloud"
          }
        }
      }
    },
    "websites": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウェブサイト"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "trang web"
          }
        }
      }
    },
    "with %@, started %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ さんと共有、%2$@ に開始"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "với %1$@, bắt đầu %2$@"
          }
        }
      }
    },
    "＋ Create new login": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "＋ 新しいログインを作成"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "＋ Tạo đăng nhập mới"
          }
        }
      }
    },
    "Some protected fields could not be unlocked, so the Extra Password was kept on. Try again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保護されたフィールドの一部をロック解除できなかったため、第 2 パスワードは有効のままです。もう一度お試しください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một số trường được bảo vệ không thể mở khóa, nên Mật khẩu cấp 2 vẫn được giữ bật. Hãy thử lại."
          }
        }
      }
    },
    "Exports include your archived items. Recently Deleted is not included.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出しにはアーカイブ済みの項目が含まれます。最近削除した項目は含まれません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản xuất bao gồm cả các mục trong Lưu trữ. Không bao gồm Đã xóa gần đây."
          }
        }
      }
    },
    "Allow Notifications": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知を許可"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép thông báo"
          }
        }
      }
    },
    "Loox uses notifications to deliver approval requests. When the person you shared with asks to use this item, the request appears as an alert on this device.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Loox は承認リクエストの通知に使用します。共有相手がこの項目の使用を求めると、このデバイスに通知が表示されます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Loox dùng thông báo để chuyển yêu cầu phê duyệt. Khi người được chia sẻ cần dùng mục này, yêu cầu sẽ hiện dưới dạng cảnh báo trên thiết bị này."
          }
        }
      }
    },
    "Loox uses notifications to deliver approval requests. When someone in this Space asks to use an item, the request appears as an alert on this device.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Loox は承認リクエストの通知に使用します。このスペースの誰かが項目の使用を求めると、このデバイスに通知が表示されます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Loox dùng thông báo để chuyển yêu cầu phê duyệt. Khi có người trong Nhóm này cần dùng một mục, yêu cầu sẽ hiện dưới dạng cảnh báo trên thiết bị này."
          }
        }
      }
    },
    "Something went wrong. Please try again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "問題が発生しました。もう一度お試しください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã xảy ra lỗi. Vui lòng thử lại."
          }
        }
      }
    },
    "No connection. Check your network and try again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続がありません。ネットワークを確認してもう一度お試しください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có kết nối. Kiểm tra mạng rồi thử lại."
          }
        }
      }
    },
    "Sign in to iCloud to continue.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続けるには iCloud にサインインしてください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập iCloud để tiếp tục."
          }
        }
      }
    },
    "Your iCloud storage is full.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ストレージがいっぱいです。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dung lượng iCloud của bạn đã đầy."
          }
        }
      }
    },
    "iCloud is busy right now. Try again in a moment.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud が混み合っています。しばらくしてからお試しください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud đang bận. Hãy thử lại sau một lát."
          }
        }
      }
    },
    "iCloud denied this request. Check that iCloud Drive is on for Loox.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud がこのリクエストを拒否しました。Loox の iCloud Drive がオンか確認してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud đã từ chối yêu cầu này. Kiểm tra xem iCloud Drive đã bật cho Loox chưa."
          }
        }
      }
    },
    "They need to verify their iCloud account before they can accept.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手は承諾する前に iCloud アカウントの確認が必要です。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người nhận cần xác minh tài khoản iCloud trước khi có thể chấp nhận."
          }
        }
      }
    },
    "This share is no longer available.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この共有は利用できなくなりました。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mục chia sẻ này không còn khả dụng."
          }
        }
      }
    },
    "Something went wrong with iCloud. Please try again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud で問題が発生しました。もう一度お試しください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã xảy ra lỗi với iCloud. Vui lòng thử lại."
          }
        }
      }
    },
    "Add your first item": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初のアイテムを追加"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm mục đầu tiên"
          }
        }
      }
    },
    "Logins, cards, notes, and passkeys all live here. Loox encrypts each one on this device.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン情報、カード、メモ、パスキーはすべてここにあります。Loox は各項目をこのデバイス上で暗号化します。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông tin đăng nhập, thẻ, ghi chú và passkey đều nằm ở đây. Loox mã hóa từng mục ngay trên thiết bị này."
          }
        }
      }
    },
    "Check your security": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セキュリティを確認"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra bảo mật"
          }
        }
      }
    },
    "Loox reviews password strength, reuse, and known leaks, then walks you through the fixes.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Loox はパスワードの強度、使い回し、既知の漏洩を確認し、修正手順を案内します。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Loox xem xét độ mạnh mật khẩu, việc dùng lại và các vụ rò rỉ đã biết, rồi hướng dẫn bạn khắc phục."
          }
        }
      }
    },
    "Everything stays on this device": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてこのデバイスに保存されます"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi thứ đều ở lại thiết bị này"
          }
        }
      }
    },
    "Your items are encrypted here and unlocked only by you. Turn on iCloud Sync in Settings when you want them on your other devices.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイテムはここで暗号化され、ロックを解除できるのはあなただけです。ほかのデバイスでも使いたいときは、設定で iCloud 同期をオンにしてください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các mục của bạn được mã hóa tại đây và chỉ bạn mở khóa được. Bật Đồng bộ iCloud trong Cài đặt khi bạn muốn dùng trên thiết bị khác."
          }
        }
      }
    },
    "Next": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次へ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiếp"
          }
        }
      }
    },
    "Skip": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキップ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bỏ qua"
          }
        }
      }
    },
    "Your vault health score": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保管庫の健全性スコア"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điểm sức khỏe kho của bạn"
          }
        }
      }
    },
    "One number out of 1000, from password strength, reuse, known leaks, and how much two-factor protection you have. Tap it to see what moved it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1000 点満点のスコアで、パスワードの強度、使い回し、既知の漏洩、2 要素保護の充実度から算出します。タップすると内訳を確認できます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một con số trên 1000, tính từ độ mạnh mật khẩu, việc dùng lại, các vụ rò rỉ đã biết và mức độ bảo vệ hai lớp. Chạm vào để xem điều gì đã tác động."
          }
        }
      }
    },
    "Run a check anytime": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつでも検査できます"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra bất cứ lúc nào"
          }
        }
      }
    },
    "Most checks run on this device. Leak checks send only the first five characters of a hashed password, never the password.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほとんどの検査はこのデバイス上で実行されます。漏洩チェックで送信するのはハッシュ化したパスワードの先頭 5 文字のみで、パスワード自体は送信しません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hầu hết kiểm tra chạy ngay trên thiết bị này. Kiểm tra rò rỉ chỉ gửi năm ký tự đầu của mã băm mật khẩu, không bao giờ gửi mật khẩu."
          }
        }
      }
    },
    "Sharing keeps you in control": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有しても主導権はあなたに"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chia sẻ nhưng bạn vẫn nắm quyền"
          }
        }
      }
    },
    "You choose which fields another person can use. Values you hand over are theirs to keep; the rest stays behind your approval.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのフィールドを相手が使えるかはあなたが選びます。引き渡した値は相手のものになり、それ以外はあなたの承認が必要なままです。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn chọn người kia được dùng những trường nào. Giá trị đã trao đi thì họ giữ được; phần còn lại vẫn cần bạn phê duyệt."
          }
        }
      }
    },
    "Requests arrive as notifications": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエストは通知で届きます"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yêu cầu đến qua thông báo"
          }
        }
      }
    },
    "When they need a field you kept under approval, Loox notifies you and you decide right then. Without notifications those requests never reach you.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認が必要なフィールドを相手が使いたいとき、Loox が通知し、その場であなたが判断します。通知がないとリクエストは届きません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi họ cần một trường bạn giữ ở chế độ phê duyệt, Loox sẽ thông báo và bạn quyết định ngay lúc đó. Không có thông báo thì yêu cầu sẽ không tới được bạn."
          }
        }
      }
    },
    "Set up AutoFill": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動入力を設定"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết lập tự động điền"
          }
        }
      }
    },
    "Once Loox is on, iOS offers your saved logins above the keyboard in other apps and Safari.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Loox をオンにすると、ほかのアプリや Safari でキーボードの上に保存済みのログイン情報が表示されます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi Loox được bật, iOS sẽ gợi ý thông tin đăng nhập đã lưu ngay trên bàn phím trong ứng dụng khác và Safari."
          }
        }
      }
    },
    "Open Settings, then General, then AutoFill & Passwords.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定」→「一般」→「自動入力とパスワード」の順に開きます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Cài đặt, chọn Cài đặt chung, rồi chọn Tự động điền và mật khẩu."
          }
        }
      }
    },
    "Turn on AutoFill Passwords and Passcodes.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「パスワードとパスコードを自動入力」をオンにします。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật Tự động điền mật khẩu và mật mã."
          }
        }
      }
    },
    "Tick Loox in the provider list. Leave iCloud Passwords on if you still use it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "提供元リストで Loox にチェックを入れます。iCloud パスワードを使い続ける場合はオンのままで構いません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn Loox trong danh sách nguồn. Cứ để iCloud Passwords bật nếu bạn vẫn dùng."
          }
        }
      }
    },
    "AutoFill & Passwords": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動入力とパスワード"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự động điền và mật khẩu"
          }
        }
      }
    },
    "AutoFill Passwords and Passcodes": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードとパスコードを自動入力"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự động điền mật khẩu và mật mã"
          }
        }
      }
    },
    "Later": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あとで"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để sau"
          }
        }
      }
    },
    "Show tutorials again": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チュートリアルをもう一度表示"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem lại hướng dẫn"
          }
        }
      }
    },
    "Tutorials reset": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チュートリアルをリセットしました"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã đặt lại hướng dẫn"
          }
        }
      }
    },
    "The guided tours will play again the next time you open those screens.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次にそれらの画面を開いたときに、ガイドが再び表示されます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các phần hướng dẫn sẽ chạy lại vào lần tới bạn mở những màn hình đó."
          }
        }
      }
    },
    "Open this on your computer": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この項目をパソコンで開く"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở mục này trên máy tính"
          }
        }
      }
    },
    "Scan the code with your computer's browser and the fields you approve appear there. Nothing is typed, and nothing is stored on the page.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パソコンのブラウザでコードを読み取ると、承認したフィールドがそこに表示されます。入力の手間はなく、ページには何も保存されません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quét mã bằng trình duyệt trên máy tính, những trường bạn phê duyệt sẽ hiện ở đó. Không phải gõ tay, và trang không lưu lại gì."
          }
        }
      }
    },
    "It closes by itself": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションは自動的に終了します"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên tự đóng"
          }
        }
      }
    },
    "The session lasts minutes, not days. When it ends the page goes blank, and you can end it from here at any time.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションは数日ではなく数分です。終了するとページの内容は消え、いつでもここから終了できます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên chỉ kéo dài vài phút, không phải vài ngày. Khi kết thúc, trang sẽ trống, và bạn có thể kết thúc từ đây bất cứ lúc nào."
          }
        }
      }
    },
    "A different address for each site": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイトごとに別のアドレス"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi trang một địa chỉ riêng"
          }
        }
      }
    },
    "Give a site its own address instead of your real one. Mail still reaches your inbox, and the site never learns where.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実際のアドレスの代わりに、サイトごとに専用のアドレスを渡します。メールはあなたの受信箱に届き、サイトは宛先を知りません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cấp cho mỗi trang một địa chỉ riêng thay vì địa chỉ thật. Thư vẫn về hộp thư của bạn, còn trang đó không biết hộp thư nằm ở đâu."
          }
        }
      }
    },
    "Turn one off and the mail stops": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにすればメールは止まります"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tắt một địa chỉ là thư ngừng tới"
          }
        }
      }
    },
    "If an address starts getting spam, pause or delete it. That address stops forwarding; every other one keeps working.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あるアドレスに迷惑メールが届き始めたら、一時停止するか削除してください。そのアドレスの転送だけが止まり、ほかは動き続けます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu một địa chỉ bắt đầu nhận thư rác, hãy tạm dừng hoặc xóa nó. Địa chỉ đó ngừng chuyển tiếp, các địa chỉ khác vẫn hoạt động."
          }
        }
      }
    },
    "No longer offered": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "提供を終了しました"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã ngừng cung cấp"
          }
        }
      }
    },
    "Loox is locked": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Loox はロックされています"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Loox đang khóa"
          }
        }
      }
    },
    "You’re offline": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインです"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đang ngoại tuyến"
          }
        }
      }
    },
    "Couldn’t verify this device": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスを確認できませんでした"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không xác minh được thiết bị này"
          }
        }
      }
    },
    "Confirm your forwarding email": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "転送先メールを確認してください"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xác nhận email nhận chuyển tiếp"
          }
        }
      }
    },
    "Too many requests": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエストが多すぎます"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quá nhiều yêu cầu"
          }
        }
      }
    },
    "Address limit reached": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アドレスの上限に達しました"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã đạt giới hạn địa chỉ"
          }
        }
      }
    },
    "Private Email is off": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プライベートメールはオフです"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Email riêng tư đang tắt"
          }
        }
      }
    },
    "Check your inbox": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "受信トレイを確認してください"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra hộp thư"
          }
        }
      }
    },
    "We sent a confirmation link to %@. Open it to finish setting up this forwarding address.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に確認リンクを送信しました。リンクを開くと、この転送先の設定が完了します。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Loox đã gửi liên kết xác nhận tới %@. Mở liên kết đó để hoàn tất thiết lập địa chỉ nhận chuyển tiếp này."
          }
        }
      }
    },
    "Confirmed": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認済み"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã xác nhận"
          }
        }
      }
    },
    "This address is verified. Private addresses can forward to it now.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアドレスは確認済みです。プライベートアドレスからの転送が可能になりました。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Địa chỉ này đã được xác minh. Các địa chỉ riêng tư có thể chuyển tiếp về đây."
          }
        }
      }
    },
    "Not confirmed yet": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ確認されていません"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa xác nhận"
          }
        }
      }
    },
    "Open the confirmation link we emailed to %@, then check again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に送信した確認リンクを開いてから、もう一度確認してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở liên kết xác nhận Loox đã gửi tới %@, rồi kiểm tra lại."
          }
        }
      }
    },
    "Each site gets its own address, so a leak at one of them never points at you.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイトごとに別のアドレスを使うので、1 か所の漏えいがあなたにたどり着くことはありません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi trang có một địa chỉ riêng, nên một vụ rò rỉ ở trang đó không lần ra được bạn."
          }
        }
      }
    },
    "Mail arrives as usual": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールはいつもどおり届きます"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thư vẫn về như thường"
          }
        }
      }
    },
    "Messages forward to your real inbox. Only you can see which address they came through.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールは実際の受信トレイに転送されます。どのアドレス経由かを知っているのはあなただけです。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thư được chuyển tiếp về hộp thư thật của bạn. Chỉ bạn biết thư đến qua địa chỉ nào."
          }
        }
      }
    },
    "If an address starts getting spam, pause or delete it. Every other one keeps working.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "迷惑メールが届き始めたら、そのアドレスを一時停止するか削除します。ほかのアドレスはそのまま使えます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu một địa chỉ bắt đầu nhận thư rác, hãy tạm dừng hoặc xóa nó. Mọi địa chỉ khác vẫn hoạt động."
          }
        }
      }
    },
    "One step first": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初にひとつだけ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Còn một bước"
          }
        }
      }
    },
    "Private addresses forward to %@. Confirm that inbox is yours and you can start creating addresses. You can manage all of this later in Private Email.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プライベートアドレスは %@ に転送されます。その受信トレイがご自身のものだと確認すれば、アドレスの作成を始められます。設定はあとから「プライベートメール」で管理できます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Địa chỉ riêng tư sẽ chuyển tiếp về %@. Xác nhận hộp thư đó là của bạn là có thể bắt đầu tạo địa chỉ. Bạn quản lý mọi thứ này sau ở mục Email riêng tư."
          }
        }
      }
    },
    "Check confirmation": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認状況を見る"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra xác nhận"
          }
        }
      }
    },
    "Send again in %llds": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 秒後に再送できます"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gửi lại sau %lld giây"
          }
        }
      }
    },
    "Send the email again": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールを再送する"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gửi lại email"
          }
        }
      }
    },
    "Send confirmation email": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認メールを送る"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gửi email xác nhận"
          }
        }
      }
    },
    "Already opened the link? Tap again to check.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクを開きましたか。もう一度タップして確認できます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã mở liên kết rồi? Bấm lại để kiểm tra."
          }
        }
      }
    },
    "You can send again in %llds": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 秒後に再送できます"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có thể gửi lại sau %lld giây"
          }
        }
      }
    },
    "Private addresses can’t forward to %@ until you confirm it’s yours. It takes one tap and an email.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ がご自身のものだと確認するまで、プライベートアドレスはそこへ転送できません。タップ 1 回とメール 1 通で完了します。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Địa chỉ riêng tư chưa chuyển tiếp được về %@ cho tới khi bạn xác nhận đó là hộp thư của mình. Chỉ cần một lần bấm và một email."
          }
        }
      }
    },
