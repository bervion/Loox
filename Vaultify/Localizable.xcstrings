    "Another device removed this device from the vault. Loox data on this device was erased. Your items remain in the vault.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another device removed this device from the vault. Loox data on this device was erased. Your items remain in the vault."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のデバイスがこのデバイスを保管庫から削除しました。このデバイス上の Loox のデータは消去されました。アイテムは保管庫に残っています。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một thiết bị khác đã gỡ thiết bị này khỏi kho. Dữ liệu Loox trên thiết bị này đã được xóa. Các mục của bạn vẫn còn trong kho."
          }
        }
