        }
      }
    },
    "The score is the sum of the six areas above. Fix an issue and run the audit again to see the change." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スコアは上の 6 領域の合計です。問題に対処してから監査をもう一度実行すると、変化が分かります。"
          }
