        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ đang yêu cầu đăng nhập bằng passkey được chia sẻ cho %2$@."
          }
        }
      }
    },
    "%@ wants to share with you": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ さんがあなたと共有しようとしています"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ muốn chia sẻ với bạn"
