          }
        }
      }
    },
    "You revoked everything you had shared with this person.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この人と共有していたものをすべて取り消しました。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã thu hồi mọi thứ từng chia sẻ với người này."
          }
        }
      }
    },
    "You'll compare a short code before anything is handed over.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何かが渡される前に、短いコードを照合します。"
