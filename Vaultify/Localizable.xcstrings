{
  "sourceLanguage": "en",
  "strings": {
    "": {},
    "#%@": {
      "comment": "A screen showing a list of items tagged with a specific hashtag. The argument is the hashtag.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "#%@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "#%@"
          }
        }
      }
    },
    "%1$@ is asking for the current verification code for %2$@.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ が %2$@ の現在の確認コードを求めています。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ đang yêu cầu mã xác minh hiện tại cho %2$@."
          }
        }
      }
    },
    "%1$@ is asking to sign in with the shared passkey for %2$@.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ が %2$@ の共有パスキーでのサインインを求めています。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ đang yêu cầu đăng nhập bằng passkey được chia sẻ cho %2$@."
          }
        }
      }
    },
    "%1$lld shared, %2$lld waiting": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 件を共有中、%2$lld 件が待機中"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã chia sẻ %1$lld mục, %2$lld đang chờ"
          }
        }
      }
    },
    "%@ a month": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月額 %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ mỗi tháng"
          }
        }
      }
    },
    "%@ a year": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "年額 %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ mỗi năm"
          }
        }
      }
    },
    "%@ accepted. Tap to finish setting up the share.": {
      "comment": "Local notification body when a recipient finished accepting a share; %@ is the recipient email (device-local).",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ さんが承諾しました。タップして共有の設定を完了してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đã chấp nhận. Nhấn để hoàn tất thiết lập chia sẻ."
          }
        }
      }
    },
    "%@ accepted. Waiting for their device to finish setting up, usually right after they unlock Loox.": {
      "comment": "Resume share sheet: recipient accepted, waiting for profile.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ さんが承諾しました。相手のデバイスで設定が完了するのを待っています。通常は Loox のロックを解除した直後に完了します。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đã chấp nhận. Đang chờ thiết bị của họ hoàn tất thiết lập, thường ngay sau khi họ mở khóa Loox."
          }
        }
      }
    },
    "%@ has joined. Activate to give them access. To be sure it's really them, you can compare this safety code with the one shown at the bottom of the shared item on their device.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ さんが参加しました。有効にするとアクセスを許可できます。本人であることを確かめるには、このセーフティコードを相手のデバイスの共有アイテム下部に表示されるコードと見比べてください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đã tham gia. Kích hoạt để cấp quyền truy cập cho họ. Để chắc chắn đúng người, bạn có thể đối chiếu mã an toàn này với mã hiển thị ở cuối mục được chia sẻ trên máy của họ."
          }
        }
      }
    },
    "%@ is asking for the current verification code for %@.": {
      "comment": "A callout that explains the request for a verification code. The first argument is the name of the person who requested the code. The second argument is the name of the item being requested.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ is asking for the current verification code for %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ が %2$@ の現在の確認コードを求めています。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ đang yêu cầu mã xác minh hiện tại cho %2$@."
          }
        }
      }
    },
    "%@ is asking to sign in with the shared passkey for %@.": {
      "comment": "A callout that describes the request for a shared passkey.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
