          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không xác minh được câu trả lời của chủ sở hữu."
          }
        }
      }
    },
    "The passkey couldn't be prepared for sharing. Lock the app, unlock it, then try again." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共有用にパスキーを準備できませんでした。アプリをロックして解除し直してから、もう一度お試しください。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chưa thể chuẩn bị passkey để chia sẻ. Hãy khóa ứng dụng, mở khóa lại rồi thử lại."
          }
        }
      }
    },
    "The purchase didn't go through. You have not been charged." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "購入は完了しませんでした。料金は請求されていません。"
          }
        },
        "vi" : {
