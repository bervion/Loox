    },
    "This shares usernames, passwords, email addresses, and websites for every eligible login currently in this Space.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作は、このスペースにある対象のログインすべてについて、ユーザー名、パスワード、メールアドレス、ウェブサイトを共有します。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này sẽ chia sẻ tên đăng nhập, mật khẩu, email và trang web của mọi mục đăng nhập đủ điều kiện hiện có trong Nhóm này."
          }
        }
      }
    },
    "This sheet stays open while the code is being issued.": {
      "localizations": {
