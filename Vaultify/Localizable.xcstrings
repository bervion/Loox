        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là danh tính duy nhất. Hãy thêm danh tính khác trước khi xóa cái này."
          }
        }
      }
    },
    "This item could use a quick review.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
