          "stringUnit": {
            "state": "translated",
            "value": "現在 iCloud に接続できません。接続と iCloud のサインインを確認してから、もう一度お試しください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện chưa kết nối được iCloud. Hãy kiểm tra kết nối mạng và đăng nhập iCloud rồi thử lại."
          }
        }
      }
    },
    "iCloud sharing isn't available in this version of Loox.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud sharing isn't available in this version of Loox."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバージョンの Loox は iCloud 共有に対応していません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên bản Loox này chưa hỗ trợ chia sẻ qua iCloud."
          }
        }
      }
    },
    "iCloud sync isn’t enabled in this build.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビルドでは iCloud 同期が有効になっていません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản dựng này chưa bật đồng bộ iCloud."
          }
        }
      }
    },
    "iCloud sync needs the iCloud capability enabled in Xcode.": {
      "comment": "Error message when iCloud sync is not configured (iCloud capability not enabled).",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 同期には、Xcode で iCloud 機能を有効にする必要があります。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đồng bộ iCloud cần bật khả năng iCloud trong Xcode."
          }
        }
      }
    },
    "iCloud would not release this share, so it can only be removed here. The owner still has you on their list, and accepting their invite again would bring it back.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud がこの共有を手放さなかったため、ここでしか削除できません。所有者の一覧にはあなたが残っており、招待をもう一度承諾すると再び表示されます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud không gỡ được chia sẻ này, nên chỉ có thể gỡ tại đây. Chủ sở hữu vẫn còn bạn trong danh sách của họ, và nếu bạn chấp nhận lại lời mời thì mục này sẽ quay lại."
          }
        }
      }
    },
    "important issues": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "重要な問題"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "vấn đề quan trọng"
          }
        }
      }
    },
    "invite.push.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone shared something with you in Loox. Open to review."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Loox で誰かがアイテムを共有しました。アプリを開いて確認してください。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có người chia sẻ một mục với bạn trong Loox. Mở ứng dụng để xem."
          }
        }
      }
    },
    "invite.push.title": {
      "localizations": {
