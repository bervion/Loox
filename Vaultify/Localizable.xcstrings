      }
    },
    "They accepted. Finishing setup on their device…" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They accepted. Finishing setup on their device…"
