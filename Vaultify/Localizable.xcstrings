    "Get a local notification on the day a password is due to rotate. The notification shows only the item name, never a password or username.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードの変更予定日に、このデバイス内の通知を受け取ります。通知に表示されるのはアイテム名だけで、パスワードやユーザー名は表示されません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhận thông báo cục bộ vào ngày cần đổi mật khẩu. Thông báo chỉ hiện tên mục, không bao giờ hiện mật khẩu hay tên đăng nhập."
          }
        }
      }
    },
    "Get a reminder every two weeks to open Loox and check your vault's health. The notification shows no scores or item details.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get a reminder every two weeks to open Loox and check your vault's health. The notification shows no scores or item details."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2 週間ごとに Loox を開いて保管庫の状態を確認するリマインダーを受け取ります。通知にスコアやアイテムの詳細は表示されません。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhận nhắc nhở mỗi hai tuần để mở Loox và kiểm tra tình trạng kho. Thông báo không hiển thị điểm số hay chi tiết mục nào."
          }
        }
      }
    },
    "Get started": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "はじめる"
          }
        },
