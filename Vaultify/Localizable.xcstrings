    },
    "You need at least one identity." : {
      "comment" : "Delete blocked because it is the last persona.",
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn cần ít nhất một danh tính."
          }
        }
      }
    },
    "You'll lose access to it. The owner can share with you again later." : {
      "localizations" : {
        "en" : {
