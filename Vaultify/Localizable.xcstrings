        }
      }
    },
    "Items are end-to-end encrypted before they sync. iCloud stores only ciphertext; neither Apple nor anyone else can read your vault." : {
      "comment" : "A description of how iCloud sync works.",
      "extractionState" : "stale",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アイテムは同期する前にエンドツーエンドで暗号化されます。iCloud が保存するのは暗号文だけで、Apple もほかの誰もあなたの保管庫を読めません。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các mục được mã hóa đầu cuối trước khi đồng bộ. iCloud chỉ lưu dữ liệu đã mã hóa; cả Apple lẫn bất kỳ ai khác đều không đọc được kho của bạn."
          }
        }
      }
    },
    "Items in Trash are still encrypted. Deleting them is permanent." : {
      "comment" : "A description of the contents of the trash.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
