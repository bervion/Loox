        }
      }
    },
    "This item could use a quick review." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mục này nên được xem lại nhanh."
          }
        }
      }
    },
    "This item has not been reviewed in years. A quick check keeps it trustworthy." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mục này đã nhiều năm chưa được xem lại. Kiểm tra nhanh giúp nó luôn đáng tin."
          }
        }
      }
    },
    "This item has nothing to send to a browser yet." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mục này chưa có gì để gửi đến trình duyệt."
          }
        }
      }
    },
    "This item is too large to open on a computer." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
