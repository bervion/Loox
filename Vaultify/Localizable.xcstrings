        }
      }
    },
    "Welcome to Loox. This is your identity. It autofills your name, email, and details into forms. Everything stays encrypted on this device; edit or add more anytime." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chào mừng đến với Loox. Đây là danh tính của bạn. Nó tự động điền tên, email và thông tin vào biểu mẫu. Mọi thứ luôn được mã hóa trên thiết bị này; chỉnh sửa hoặc thêm bất cứ lúc nào."
          }
        }
