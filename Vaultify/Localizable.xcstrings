    "Private Email is currently unavailable. Loox has temporarily disabled this feature. Your vault and other features continue to work normally.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プライベートメールは現在利用できません。Loox がこの機能を一時的に停止しています。保管庫とほかの機能は通常どおり使えます。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Email riêng tư hiện không khả dụng. Loox đã tạm tắt tính năng này. Kho của bạn và các tính năng khác vẫn hoạt động bình thường."
          }
        }
      }
    },
    "Private Email is no longer offered by Loox. Your saved alias records remain visible so you can identify accounts that used them.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Loox はプライベートメールの提供を終了しました。保存済みのエイリアスの記録は、使っていたアカウントを見分けられるよう残しています。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Loox không còn cung cấp Email riêng tư. Các địa chỉ đã lưu vẫn hiển thị để bạn nhận diện tài khoản từng dùng chúng."
          }
        }
      }
    },
    "Private Email is turned off in Settings.": {
