      }
    },
    "This field is malformed." : {
      "comment" : "A message displayed when a field is malformed.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このフィールドの形式が正しくありません。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trường này bị lỗi định dạng."
          }
        }
      }
    },
    "This field will be protected with your Extra Password." : {
      "comment" : "A description of the extra password protection for a field.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このフィールドは第 2 パスワードで保護されます。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trường này sẽ được bảo vệ bằng Mật khẩu cấp 2 của bạn."
          }
        }
      }
    },
    "This file holds more records than one import can restore safely." : {
      "comment" : "ImportView — row, passkey or artifact count ceiling exceeded.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このファイルには、1 回の読み込みで安全に復元できる数を超えるレコードが含まれています。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tệp này chứa nhiều bản ghi hơn mức một lần nhập có thể khôi phục an toàn."
          }
        }
      }
    },
    "This file is removed when you leave this screen, when the app is backgrounded, and when the vault locks." : {
      "comment" : "ExportView — footer under Share Export, telling the user how long the export file lives (it is plaintext for a CSV export).",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このファイルは、この画面を離れたとき、アプリがバックグラウンドに移ったとき、保管庫がロックされたときに削除されます。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tệp này sẽ bị xóa khi bạn rời màn hình này, khi ứng dụng chuyển sang chạy nền và khi kho bị khóa."
          }
        }
      }
    },
    "This file is too large to import safely." : {
      "comment" : "ImportView — file or sealed-payload byte ceiling refused before the file is read into memory.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このファイルは大きすぎるため、安全に読み込めません。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tệp này quá lớn để có thể nhập an toàn."
          }
        }
      }
    },
    "This identity doesn’t have a Space yet. Create one to start adding items." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
