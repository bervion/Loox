    "Enter the key from your saved Emergency Kit. This works only if that vault had iCloud Sync on before you lost the device." : {
      "comment" : "RestoreMethodSheet — 'Use Recovery Key' option detail.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存済みの緊急キットにあるキーを入力します。これは、デバイスを失う前にその保管庫で iCloud 同期がオンだった場合にのみ使えます。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhập khóa trong Bộ khôi phục bạn đã lưu. Cách này chỉ dùng được nếu kho đó đã bật Đồng bộ iCloud trước khi bạn mất thiết bị."
          }
        }
      }
    },
    "Enter the key printed in the Emergency Kit (PDF) you saved." : {
      "extractionState" : "stale",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存した緊急キット (PDF) に印字されたキーを入力してください。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhập khóa in trong Bộ khôi phục (PDF) bạn đã lưu."
          }
        }
      }
    },
    "Enter the passphrase for this .p12 file. It is used once to read the certificate details and is not stored." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この.p12ファイルのパスフレーズを入力してください。証明書情報の読み取りに一度だけ使用され、保存されません。"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhập cụm mật khẩu của tệp .p12 này. Nó chỉ dùng một lần để đọc thông tin chứng chỉ và không được lưu lại."
          }
        }
      }
    },
    "Enter the recipient's iCloud email first." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter the recipient's iCloud email first."
