        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đây là cài đặt duy nhất quyết định Bộ khôi phục của bạn có khôi phục được kho trên thiết bị khác hay không."
          }
        }
      }
    },
    "This is your Loox account, the identity for this vault. Keep the email safe; you may need it to set up sync or recover access." : {
      "extractionState" : "stale",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これはこの保管庫のプロフィールとなる Loox アカウントです。同期の設定やアクセスの復旧に必要になることがあるので、メールアドレスは大切に保管してください。"
          }
        },
        "vi" : {
