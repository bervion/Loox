        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn cần kết nối internet để xem mục được chia sẻ này. Các bí mật của mục vẫn được niêm phong cho đến khi quyền truy cập được xác minh."
          }
        }
      }
    },
    "You need at least one identity.": {
      "comment": "Delete blocked because it is the last persona.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロフィールは少なくとも 1 つ必要です。"
