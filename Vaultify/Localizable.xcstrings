    "That recovery key didn’t work." : {
      "comment" : "Error message when the recovery key provided is invalid.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その復旧キーは使えませんでした。"
          }
