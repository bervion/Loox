{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vaultify.local/quality/transition.schema.json",
  "title": "Vaultify state transition",
  "type": "object",
  "required": ["transition_id", "name", "from_state_id", "to_state_id", "trigger", "critical", "verification_status", "evidence_ids"],
  "properties": {
    "transition_id": {"type": "string", "pattern": "^TRANS-[A-Z0-9-]+$"},
    "name": {"type": "string", "minLength": 1},
    "from_state_id": {"type": "string", "pattern": "^STATE-[A-Z0-9-]+$"},
    "to_state_id": {"type": "string", "pattern": "^STATE-[A-Z0-9-]+$"},
    "trigger": {"type": "string", "minLength": 1},
    "critical": {"type": "boolean"},
    "verification_status": {"enum": ["known", "verified", "stale", "blocked"]},
    "evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^EVID-[A-Z0-9-]+$"}}
  },
  "additionalProperties": false
}
