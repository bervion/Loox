{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vaultify.local/quality/surface.schema.json",
  "title": "Vaultify user-visible surface",
  "type": "object",
  "required": ["surface_id", "name", "kind", "entry_points", "source_refs", "verification_status", "evidence_ids"],
  "properties": {
    "surface_id": {"type": "string", "pattern": "^SURF-[A-Z0-9]+-[0-9]{3}$"},
    "name": {"type": "string", "minLength": 1},
    "kind": {"enum": ["screen", "sheet", "flow", "extension", "system-prompt"]},
    "entry_points": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "verification_status": {"enum": ["known", "verified", "stale", "blocked"]},
    "evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^EVID-[A-Z0-9-]+$"}}
  },
  "additionalProperties": false
}
