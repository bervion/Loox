{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vaultify.local/quality/evidence.schema.json",
  "title": "Vaultify verification evidence",
  "type": "object",
  "required": ["evidence_id", "captured_at", "tested_sha", "tested_tree", "tested_input_digest", "verifier", "independent", "claims", "ci_attestations", "tool", "environment", "artifacts", "redaction", "covers"],
  "properties": {
    "evidence_id": {"type": "string", "pattern": "^EVID-[A-Z0-9-]+$"},
    "captured_at": {"type": "string", "format": "date-time"},
    "tested_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "tested_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "tested_input_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "verifier": {"type": "string", "minLength": 1},
    "independent": {"const": true},
    "claims": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["GATE-LEDGER", "GATE-TESTS", "GATE-PRIVACY", "GATE-LOCALIZATION", "GATE-ROLLBACK", "GATE-RISKS", "GATE-OPERATIONS"]}},
    "risk_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^RISK-[A-Z0-9]+-[0-9]{3}$"}},
    "ci_attestations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["gate_id", "provider", "repository", "workflow_path", "run_id", "run_attempt", "job_name", "conclusion", "head_sha", "artifact_id", "artifact_name", "artifact_digest", "payload_path", "payload_sha256"],
        "properties": {
          "gate_id": {"enum": ["GATE-LEDGER", "GATE-TESTS", "GATE-PRIVACY", "GATE-LOCALIZATION", "GATE-ROLLBACK", "GATE-RISKS", "GATE-OPERATIONS"]},
          "provider": {"const": "github-actions"},
          "repository": {"const": "bervion/Vaultify"},
          "workflow_path": {"type": "string", "pattern": "^\\.github/workflows/.+\\.ya?ml$"},
          "run_id": {"type": "integer", "minimum": 1},
          "run_attempt": {"type": "integer", "minimum": 1},
          "job_name": {"type": "string", "minLength": 1},
          "conclusion": {"const": "success"},
          "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "artifact_id": {"type": "integer", "minimum": 1},
          "artifact_name": {"type": "string", "minLength": 1},
          "artifact_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "payload_path": {"type": "string", "minLength": 1},
          "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "tool": {
      "type": "object",
      "required": ["name", "version", "command"],
      "properties": {"name": {"type": "string"}, "version": {"type": "string"}, "command": {"type": "string"}},
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": ["os", "xcode", "device", "locale", "appearance"],
      "properties": {"os": {"type": "string"}, "xcode": {"type": "string"}, "device": {"type": "string"}, "locale": {"type": "string"}, "appearance": {"type": "string"}},
      "additionalProperties": true
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "kind"],
        "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "media_type": {"type": "string"}, "kind": {"enum": ["coverage-ledger-report", "test-summary", "privacy-audit", "localization-matrix", "recovery-rehearsal", "risk-disposition-report", "release-operations-plan", "screenshot", "log"]}},
        "additionalProperties": false
      }
    },
    "redaction": {
      "type": "object",
      "required": ["reviewed", "contains_user_data", "method"],
      "properties": {"reviewed": {"const": true}, "contains_user_data": {"const": false}, "method": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "covers": {
      "type": "object",
      "required": ["surfaces", "states", "transitions", "journeys"],
      "properties": {
        "surfaces": {"type": "array", "items": {"type": "string"}},
        "states": {"type": "array", "items": {"type": "string"}},
        "transitions": {"type": "array", "items": {"type": "string"}},
        "journeys": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
